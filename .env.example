# Application
APP_NAME=College RAG

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=college_rag

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.2

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ingestion
MAX_UPLOAD_SIZE_MB=20
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=80

# Retrieval
RETRIEVAL_TOP_K=5
# Must match your EMBEDDING_MODEL (nomic-embed-text=768, bge-m3=1024)
EMBEDDING_DIMS=768
# auto | vector | local  (vector requires MongoDB Atlas Vector Search)
VECTOR_SEARCH_MODE=auto

# RAG / generation
# Evidence below this relevance score is not used to answer questions
RELEVANCE_THRESHOLD=0.4
# Token budget for context sent to the LLM
CONTEXT_MAX_TOKENS=3000
